# ── Backend server connection ──────────────────────────────────────────────────
# URL of the alexa-pc-control server (docker service name or public URL)
SERVER_URL=http://server:3000

# API key must match the API_KEY set in the server service
API_KEY=change-me-in-production

# ── HTTP server ────────────────────────────────────────────────────────────────
PORT=3001

# ── Device configuration ───────────────────────────────────────────────────────
# Option A – multi-device JSON array (takes precedence over Option B)
# DEVICES='[{"deviceId":"my-pc","friendlyName":"My PC","macAddress":"AA:BB:CC:DD:EE:FF","description":"Main desktop"}]'

# Option B – single device via individual env vars
DEFAULT_DEVICE_ID=my-pc
DEFAULT_DEVICE_NAME=My PC
DEFAULT_MAC=AA:BB:CC:DD:EE:FF
