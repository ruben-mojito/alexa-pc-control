# Agent environment variables
# Copy to .env and fill in real values before running.

# WebSocket URL of the backend server
SERVER_URL=ws://your-server-host:3000/ws

# HTTP URL of the backend server (for token retrieval)
SERVER_HTTP_URL=http://your-server-host:3000

# Shared API key (must match the server's API_KEY)
API_KEY=change-me-in-production

# Unique identifier for this device (defaults to hostname)
DEVICE_ID=my-pc

# Friendly display name for this device
DEVICE_NAME=My PC

# Milliseconds to wait before reconnecting after a disconnect
RECONNECT_DELAY_MS=5000
