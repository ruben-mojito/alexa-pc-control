# Server environment variables
# Copy to .env and fill in real values before running.

# HTTP port
PORT=3000

# Secret used to sign JWTs. CHANGE THIS in production!
JWT_SECRET=change-me-in-production

# Shared API key used by Alexa Lambda and the agent to obtain JWTs.
# CHANGE THIS in production!
API_KEY=change-me-in-production

# JWT expiry (e.g. 1h, 24h, 7d)
TOKEN_EXPIRY=1h
